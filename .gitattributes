# =============================================================================
# LuminaForge .gitattributes
# =============================================================================
# Controls how Git handles line endings and identifies binary files.
# This is critical for:
#   - Cross-platform development (Linux / macOS / Windows)
#   - Preventing corruption of media files and AI model weights
#   - Clean diffs and merges

# -----------------------------------------------------------------------------
# Text files - Normalize line endings to LF (Unix style)
# This avoids annoying "LF vs CRLF" issues across operating systems.
# -----------------------------------------------------------------------------
*.py            text=auto eol=lf
*.md            text=auto eol=lf
*.rst           text=auto eol=lf
*.txt           text=auto eol=lf
*.yaml          text=auto eol=lf
*.yml           text=auto eol=lf
*.json          text=auto eol=lf
*.toml          text=auto eol=lf
*.cfg           text=auto eol=lf
*.ini           text=auto eol=lf
*.sh            text=auto eol=lf
*.bash          text=auto eol=lf
Makefile        text=auto eol=lf
Dockerfile*     text=auto eol=lf
*.css           text=auto eol=lf
*.html          text=auto eol=lf
*.js            text=auto eol=lf
*.ts            text=auto eol=lf
*.pyi           text=auto eol=lf

# -----------------------------------------------------------------------------
# Binary files - Do NOT treat as text (prevents corruption + useless diffs)
# -----------------------------------------------------------------------------
# Images
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.bmp           binary
*.ico           binary
*.svg           text=auto

# Audio
*.wav           binary
*.mp3           binary
*.flac          binary
*.ogg           binary
*.m4a           binary
*.aac           binary

# Video
*.mp4           binary
*.mov           binary
*.avi           binary
*.webm          binary
*.mkv           binary

# AI / ML model files (extremely important for this project)
*.safetensors   binary
*.bin           binary
*.pt            binary
*.pth           binary
*.ckpt          binary
*.gguf          binary
*.ggml          binary
*.onnx          binary
*.pb            binary
*.h5            binary

# Archives and other binary formats
*.zip           binary
*.tar           binary
*.tar.gz        binary
*.tgz           binary
*.rar           binary
*.7z            binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary

# -----------------------------------------------------------------------------
# Optional: Git LFS configuration (uncomment if you want to use Git LFS)
# -----------------------------------------------------------------------------
# Large model and media files can be stored with Git LFS instead of bloating
# the repository. Only enable this if your team agrees to use Git LFS.
#
# *.safetensors   filter=lfs diff=lfs merge=lfs -text
# *.bin           filter=lfs diff=lfs merge=lfs -text
# *.pt            filter=lfs diff=lfs merge=lfs -text
# *.pth           filter=lfs diff=lfs merge=lfs -text
# *.gguf          filter=lfs diff=lfs merge=lfs -text
# *.wav           filter=lfs diff=lfs merge=lfs -text
# *.mp4           filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Other useful settings
# -----------------------------------------------------------------------------
# Prevent Git from diffing log files
*.log           binary

# Mark generated / output content so GitHub language statistics are cleaner
**/outputs/**           linguist-generated=true
**/data/history.db      linguist-generated=true
**/__pycache__/**       linguist-generated=true
**/.venv/**             linguist-generated=true

# Force shell scripts to always have executable bit
*.sh            text eol=lf
scripts/**      text eol=lf

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# After adding this file, it's a good idea to run:
#   git add --renormalize .
#
# This will fix line endings for files that were previously committed with
# the wrong line endings.
